<?xml version="1.0" encoding="utf-8"?>
<stetic-interface>
  <configuration>
    <images-root-path>..</images-root-path>
    <target-gtk-version>2.12</target-gtk-version>
  </configuration>
  <import>
    <widget-library name="../../../../bin/win/tools/GuiWidgets.dll" internal="true" />
  </import>
  <widget class="Gtk.Bin" id="GuiWidgets.TitleBox" design-size="563 26">
    <property name="MemberName" />
    <property name="Visible">False</property>
    <child>
      <widget class="Gtk.HBox" id="hboxTitleBar">
        <property name="MemberName" />
        <child>
          <widget class="Gtk.EventBox" id="eventboxCaption">
            <property name="MemberName" />
            <child>
              <widget class="Gtk.Label" id="labelCaption">
                <property name="MemberName" />
                <property name="LabelProp" translatable="yes">Title</property>
              </widget>
            </child>
          </widget>
          <packing>
            <property name="Position">0</property>
            <property name="AutoSize">False</property>
          </packing>
        </child>
        <child>
          <widget class="Gtk.EventBox" id="eventboxButtons">
            <property name="MemberName" />
            <child>
              <widget class="Gtk.Fixed" id="fixedButtons">
                <property name="MemberName" />
                <property name="WidthRequest">70</property>
                <property name="HasWindow">False</property>
                <child>
                  <widget class="Gtk.Button" id="buttonMinimize">
                    <property name="MemberName" />
                    <property name="WidthRequest">22</property>
                    <property name="HeightRequest">22</property>
                    <property name="CanFocus">True</property>
                    <property name="Type">TextAndIcon</property>
                    <property name="Icon">resource:GuiWidgets.minimize_button_normal.png</property>
                    <property name="Label" translatable="yes" />
                    <property name="UseUnderline">True</property>
                  </widget>
                  <packing>
                    <property name="X">2</property>
                    <property name="Y">2</property>
                  </packing>
                </child>
                <child>
                  <widget class="Gtk.Button" id="buttonMaximize">
                    <property name="MemberName" />
                    <property name="WidthRequest">22</property>
                    <property name="HeightRequest">22</property>
                    <property name="CanFocus">True</property>
                    <property name="Type">TextAndIcon</property>
                    <property name="Icon">resource:GuiWidgets.maximize_button_normal.png</property>
                    <property name="Label" translatable="yes" />
                    <property name="UseUnderline">True</property>
                  </widget>
                  <packing>
                    <property name="X">24</property>
                    <property name="Y">2</property>
                  </packing>
                </child>
                <child>
                  <widget class="Gtk.Button" id="buttonClose">
                    <property name="MemberName" />
                    <property name="WidthRequest">22</property>
                    <property name="HeightRequest">22</property>
                    <property name="CanFocus">True</property>
                    <property name="Type">TextAndIcon</property>
                    <property name="Icon">resource:GuiWidgets.close_button_normal.png</property>
                    <property name="Label" translatable="yes" />
                    <property name="UseUnderline">True</property>
                  </widget>
                  <packing>
                    <property name="X">46</property>
                    <property name="Y">2</property>
                  </packing>
                </child>
              </widget>
            </child>
          </widget>
          <packing>
            <property name="PackType">End</property>
            <property name="Position">1</property>
            <property name="AutoSize">False</property>
            <property name="Expand">False</property>
            <property name="Fill">False</property>
          </packing>
        </child>
      </widget>
    </child>
  </widget>
</stetic-interface>